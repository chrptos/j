# ローカル開発用。コピー先の.env.localを編集する。
HTTP_PORT=8080
API_HOST_PORT=8080
API_BIND_HOST=127.0.0.1
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=5s
DB_HOST=db
DB_PORT=5432
POSTGRES_USER=j
POSTGRES_PASSWORD=j_local
POSTGRES_DB=j
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_CONNECT_TIMEOUT=2s
DB_LOCK_TIMEOUT=1s
DB_STATEMENT_TIMEOUT=3s
DB_STARTUP_TIMEOUT=5s
HEALTH_DB_TIMEOUT=1s
API_CPUS=2
API_MEMORY=1g
DB_CPUS=2
DB_MEMORY=2g
API_STOP_GRACE_PERIOD=10s
DB_HEALTH_INTERVAL=2s
DB_HEALTH_TIMEOUT=2s
DB_HEALTH_RETRIES=15
